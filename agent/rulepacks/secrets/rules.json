[
  {
    "id": "beet-secrets-dotfiles",
    "family": "secrets",
    "tool": "^(?:Bash|exec|shell|Read|Edit|Write|read_file|list_directory)$",
    "pattern": "(?:^|[/\\\\])(?:\\.sentryclirc|\\.netrc)\\b|(?:^|[/\\\\])\\.env(?!\\.(?:example|sample|template)(?=$|[/\\\\\\\"'\\s]))(?:\\.[A-Za-z0-9_-]+)?(?=$|[/\\\\\\\"'\\s])",
    "reason": "Protects local token files and non-template environment files from agent access."
  },
  {
    "id": "beet-secrets-private-keys",
    "family": "secrets",
    "tool": "^(?:Bash|exec|shell|Read|Edit|Write|read_file|list_directory)$",
    "pattern": "(?:^|[/\\\\])id_(?:rsa|ecdsa|ed25519)(?!\\.pub(?=$|[/\\\\\\\"'\\s]))(?:\\.[A-Za-z0-9_-]+)?(?=$|[/\\\\\\\"'\\s])",
    "reason": "Protects SSH private keys from agent access."
  },
  {
    "id": "beet-secrets-signing-material",
    "family": "secrets",
    "tool": "^(?:Bash|exec|shell|Read|Edit|Write|read_file|list_directory)$",
    "pattern": "\\.(?:p8|p12|mobileprovision)(?=$|[/\\\\\\\"'\\s])",
    "reason": "Protects signing keys, certificates, and provisioning profiles."
  },
  {
    "id": "beet-secrets-credential-json",
    "family": "secrets",
    "tool": "^(?:Bash|exec|shell|Read|Edit|Write|read_file|list_directory)$",
    "pattern": "(?:^|[/\\\\])[^/\\\\\\\"']*(?:service[-_]?account|credentials)[^/\\\\\\\"']*\\.json\\b",
    "reason": "Protects service-account and credential JSON files."
  },
  {
    "id": "beet-network-secret-url",
    "family": "network-exfiltration",
    "tool": "^(?:web_fetch|web_search)$",
    "pattern": "https?://[^\\\"\\s]*(?:sk_(?:live|test)_[A-Za-z0-9_-]{8,}|bearer(?:=|:|%3[aA]|%20|/)[A-Za-z0-9._~%+-]{8,}|(?:access[_-]?token|api[_-]?key)(?:=|%3[dD]|/)[A-Za-z0-9._~%+-]{8,})",
    "reason": "Blocks web requests that place API keys or bearer tokens in a URL."
  }
]
